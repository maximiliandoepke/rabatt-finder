# Einstellungen für den Rabatt-Finder.
# Kopieren nach /opt/rabatt-finder/.env und mit "chmod 600 .env" schützen.
# Diese Datei NIE ins Git-Repository hochladen (.env steht in .gitignore).

# Ordner, aus dem Caddy die Seite /angebote/ ausliefert
WEB_ROOT=/var/www/angebote

# Port der Empfangsstelle für den Lesezeichen-Knopf (nur lokal erreichbar, Caddy leitet weiter)
UPLOAD_PORT=8091

# Corporate Benefits wird NICHT vom Server ausgelesen (die Seite sperrt automatische Zugriffe),
# sondern per Lesezeichen-Knopf aus dem eigenen Browser eingespielt. Zugangsdaten werden daher nicht benötigt.
