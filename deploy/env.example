# Zugangsdaten und Einstellungen für den Rabatt-Finder.
# Kopieren nach /opt/rabatt-finder/.env, ausfüllen und mit "chmod 600 .env" schützen.
# Diese Datei NIE ins Git-Repository hochladen (.env steht in .gitignore).

CB_URL=https://miele.mitarbeiterangebote.de
CB_EMAIL=
CB_PASSWORD=

# Ordner, aus dem der Webserver die Seite /angebote/ ausliefert
WEB_ROOT=/var/www/angebote
